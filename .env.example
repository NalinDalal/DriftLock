DATABASE_URL=postgresql://driftlock:driftlock@localhost:5432/driftlock
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# Inbound capture signatures (per endpoint). When an endpoint has an entry,
# unsigned/invalid payloads are rejected with 401 before baselines are touched.
# Format: "endpoint:secret,..." — secrets may contain ':'.
# Stripe: copy the signing secret (whsec_...) from Dashboard → Webhooks.
# Generic vendors: any shared secret, sent as x-webhook-signature: sha256=<hex>.
CAPTURE_SECRETS=stripe:whsec_replace_me
# GitHub App webhook secret (enforced when set; unsigned deliveries rejected).
GITHUB_WEBHOOK_SECRET=
# Backend API auth. Static operator token (dashboards, deploys). User/workflow
# keys (dlk_...) are issued via /api/settings/rotate and verified by hash.
# Dashboard sessions ride an httpOnly cookie (SameSite=Lax). Unset = open (dev only).
BEARER_TOKEN=
# Encrypts stored GitHub OAuth tokens (AES-256-GCM, 64 hex chars = 32 bytes).
# Required in production (boot refuses without it); unset = plaintext with a
# warning (dev only). Generate: openssl rand -hex 32
SESSION_ENC_KEY=
# Per-minute request quotas (in-memory, per instance).
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_OPEN_PER_MINUTE=120
# Unsigned-webhook escape hatches (dev only). In production (NODE_ENV=production)
# unsigned GitHub deliveries and captures are rejected with 401 unless the
# matching ALLOW_UNSIGNED_* is explicitly set to "true".
NODE_ENV=development
ALLOW_UNSIGNED_WEBHOOKS=
ALLOW_UNSIGNED_CAPTURE=
