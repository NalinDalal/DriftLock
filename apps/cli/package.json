{
  "name": "@driftlock/cli",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "driftlock": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --compile --outfile dist/driftlock",
    "dev": "bun src/index.ts",
    "start": "bun dist/driftlock",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@driftlock/core": "workspace:*",
    "@driftlock/parser": "workspace:*",
    "@driftlock/agent": "workspace:*",
    "@driftlock/sandbox": "workspace:*",
    "@driftlock/git": "workspace:*",
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "ora": "^7.0.0",
    "inquirer": "^9.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0"
  }
}
