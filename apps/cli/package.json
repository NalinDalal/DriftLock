{
    "name": "@driftlock/cli",
    "version": "0.1.0",
    "private": true,
    "main": "./index.ts",
    "types": "./index.ts",
    "type": "module",
    "bin": {
        "driftlock": "./dist/index.js"
    },
    "scripts": {
        "build": "bun build ./index.ts --outdir ./dist --target node --external @driftlock/* --external ssh2 --external cpu-features",
        "typecheck": "tsc --noEmit",
        "test": "bun test",
        "test:unit": "bun test packages/tests/unit/cli",
        "test:integration": "bun test packages/tests/integration/cli",
        "test:e2e": "bun test packages/tests/e2e",
        "test:watch": "bun test --watch",
        "test:coverage": "c8 --branches 100 --functions 100 --lines 100 --statements 100 bun test"
    },
    "dependencies": {
        "@driftlock/agent": "workspace:*",
        "@driftlock/git": "workspace:*",
        "@driftlock/parser": "workspace:*",
        "@driftlock/sandbox": "workspace:*",
        "chalk": "^5.3.0",
        "commander": "^12.0.0",
        "inquirer": "^9.2.0",
        "ora": "^8.0.0"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "typescript": "^5.3.0"
    }
}
