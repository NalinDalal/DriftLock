{
    "name": "@driftlock/cli",
    "version": "0.1.0",
    "type": "module",
    "main": "./dist/index.js",
    "bin": {
        "driftlock": "./dist/index.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "bun build ./index.ts --outdir ./dist --target bun --external tree-sitter --external tree-sitter-typescript --external tree-sitter-javascript --external cpu-features",
        "prepublishOnly": "bun run build && bun scripts/prepare-publish.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --ext .ts"
    },
    "dependencies": {
        "@driftlock/agent": "workspace:*",
        "@driftlock/core": "workspace:*",
        "@driftlock/diff": "workspace:*",
        "@driftlock/git": "workspace:*",
        "@driftlock/aiFix": "workspace:*",
        "@driftlock/parser": "workspace:*",
        "@driftlock/pipeline": "workspace:*",
        "@driftlock/sandbox": "workspace:*",
        "@driftlock/vendorWatch": "workspace:*",
        "@driftlock/webhookCapture": "workspace:*",
        "chalk": "^5.3.0",
        "commander": "^12.0.0",
        "inquirer": "^9.2.0",
        "ora": "^8.0.0",
        "tree-sitter": "0.21.1",
        "tree-sitter-javascript": "0.21.4",
        "tree-sitter-typescript": "0.21.2"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "typescript": "^5.3.0"
    }
}
