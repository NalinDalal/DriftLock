{
    "name": "@driftlock/be",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun --hot --env-file=../../.env run src/index.ts",
        "start": "bun run src/index.ts",
        "build": "bun build ./src/index.ts --outdir ./dist --target bun --external ssh2 --external cpu-features",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --ext .ts"
    },
    "dependencies": {
        "@driftlock/agent": "workspace:*",
        "@driftlock/core": "workspace:*",
        "@driftlock/db": "workspace:*",
        "@driftlock/pipeline": "workspace:*",
        "@driftlock/vendorWatch": "workspace:*",
        "simple-git": "^3.23.0"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "typescript": "^5.3.0"
    }
}