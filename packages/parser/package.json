{
    "name": "@driftlock/parser",
    "version": "0.1.0",
    "private": true,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "bun test",
        "test:unit": "bun test packages/tests/unit/parser",
        "test:integration": "bun test packages/tests/integration/parser",
        "test:e2e": "bun test packages/tests/e2e",
        "test:watch": "bun test --watch",
        "test:coverage": "c8 --branches 100 --functions 100 --lines 100 --statements 100 bun test"
    },
    "dependencies": {
        "@driftlock/core": "workspace:*",
        "tree-sitter": "^0.25.1",
        "tree-sitter-javascript": "^0.25.0",
        "tree-sitter-typescript": "^0.23.2"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "typescript": "^5.3.0"
    }
}
