{
  "name": "@driftlock/sandbox",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test packages/tests/unit/sandbox",
    "test:integration": "bun test packages/tests/integration/sandbox",
    "test:e2e": "bun test packages/tests/e2e",
    "test:watch": "bun test --watch",
    "test:coverage": "c8 --branches 100 --functions 100 --lines 100 --statements 100 bun test"
  },
  "dependencies": {
    "@driftlock/core": "workspace:*",
    "dockerode": "^4.0.0",
    "http-proxy": "^1.18.0"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.0",
    "@types/http-proxy": "^1.17.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0"
  }
}
